#!/bin/sh
set -eu

ARCH="$(dpkg --print-architecture)"
case "$ARCH" in
  amd64|arm64) ;;
  *) echo "Unsupported Kinetix kernel architecture: $ARCH" >&2; exit 1 ;;
esac

echo "Installing Linux kernel for Debian architecture: $ARCH"
apt-get update
DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "linux-image-$ARCH"
