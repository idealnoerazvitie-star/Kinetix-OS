#!/bin/sh
set -eu

lb config \
  --mode debian \
  --distribution trixie \
  --architectures amd64 \
  --binary-image iso-hybrid \
  --archive-areas "main contrib non-free non-free-firmware" \
  --debian-installer live \
  --debian-installer-gui true \
  --apt-recommends false \
  --bootappend-live "boot=live components quiet splash username=kinetix hostname=kinetix" \
  --iso-application "Kinetix OS" \
  --iso-publisher "Kinetix OS Project" \
  --iso-volume "KINETIX_LIVE" \
  --iso-preparer "Kinetix OS build system"
