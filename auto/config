#!/bin/sh
set -eu

lb config \
  --mode debian \
  --distribution trixie \
  --architectures amd64 \
  --binary-image iso-hybrid \
  --archive-areas "main contrib non-free non-free-firmware" \
  --debian-installer live \
  --debian-installer-gui true \
  --apt-recommends true \
  --bootappend-live "boot=live components quiet splash username=quantix hostname=quantix" \
  --iso-application "Quantix OS" \
  --iso-publisher "Quantix OS Project" \
  --iso-volume "QUANTIX_LIVE" \
  --iso-preparer "Quantix OS build system"
